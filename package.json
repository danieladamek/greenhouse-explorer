{
  "name": "greenhouse-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Greenhouse Explorer — prototype for critique: the plants of the UAH Greenhouse and their constituents. NOT PEER REVIEWED; not an official UAH resource; content current as of 2026-09-23.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
